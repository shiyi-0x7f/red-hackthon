# ============================================================
# AI Learning Server - 环境变量配置
# ============================================================

# --- 基础 ---
SERVER_HOST=0.0.0.0
SERVER_PORT=9000
LOG_LEVEL=INFO

# --- 数据库 ---
DATABASE_URL=sqlite:///./ai_learning.db
# 复用 src-tauri/migrations/*.sql，Tauri 和 server 共享同一套 schema
MIGRATIONS_DIR=../src-tauri/migrations

# --- API 鉴权（必填） ---
# 客户端（Tauri / AstrBot）访问 server 的 Bearer token
LEARNING_API_KEY=sk-ai-learning-change-me

# --- LLM：硅基流动 ---
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
SILICONFLOW_DEFAULT_MODEL=deepseek-ai/DeepSeek-V3

# --- CORS (Tauri 客户端 + 前端生产域名) ---
CORS_ORIGINS=*

# --- 家长端密码默认值（首次启动若无则使用） ---
DEFAULT_PARENT_PASSWORD=123456

# --- 题库/知识图谱 JSON 路径 ---
# 相对 server/ 目录，或绝对路径
DATA_DIR=../data

# --- 前端 SPA 静态目录（B1 同域部署方案）---
# 如果目录存在且包含 index.html，server 会挂载它作为根路径的 SPA 服务：
#   - /assets/* → vite 构建产物的哈希资源
#   - 其他所有 GET → 先尝试返回存在的静态文件，否则回退到 index.html
# 用法：
#   本地：   cp -r ../dist ./static    （在项目根 npm run build 后）
#   Docker： COPY dist /app/static      或 volume mount -v ./dist:/app/static:ro
# 目录不存在或为空时 → server 以纯 API 模式运行（不影响 /api/v1/* 路由）
FRONTEND_DIST_DIR=./static
